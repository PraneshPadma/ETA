import pandas as pd
import os
from collections import Counter

# ==========================================
# STEP 1: Define dataset folder path
# ==========================================

data_path = r"C:\Users\prane\Downloads\DFCD\Delivery_Five_Cities_Datasets"

# ==========================================
# STEP 2: List all CSV filenames
# ==========================================

filenames = [
    "delivery_cq.csv",
    "delivery_jl.csv",   # Change if filename differs
    "delivery_hz.csv",
    "delivery_sh.csv",
    "delivery_yt.csv"
]

# ==========================================
# STEP 3: Check available files
# ==========================================

print("Files inside dataset folder:")
print(os.listdir(data_path))

# ==========================================
# STEP 4: Read all CSV files
# ==========================================

dfs = {
    f"df_city{i+1}": pd.read_csv(os.path.join(data_path, file))
    for i, file in enumerate(filenames)
}

print("\nLoaded DataFrames:")
print(dfs.keys())

# ==========================================
# STEP 5: Access individual DataFrames
# ==========================================

df_city1 = dfs['df_city1']
df_city2 = dfs['df_city2']
df_city3 = dfs['df_city3']
df_city4 = dfs['df_city4']
df_city5 = dfs['df_city5']

# ==========================================
# STEP 6: Merge all datasets
# ==========================================

merged_df = pd.concat(
    [df_city1, df_city2, df_city3, df_city4, df_city5],
    ignore_index=True
)

# ==========================================
# STEP 7: Display basic information
# ==========================================

print("\nFirst 5 rows:")
print(merged_df.head())

print("\nDataset Info:")
print(merged_df.info())

# ==========================================
# STEP 8: Count records by city
# ==========================================

city_counts = Counter(merged_df['city'])

print("\nCity Counts:")
print(city_counts)

# ==========================================
# STEP 9: Remove duplicate rows
# ==========================================

merged_df = merged_df.drop_duplicates()

print("\nShape after removing duplicates:")
print(merged_df.shape)

# ==========================================
# STEP 10: Save merged dataset
# ==========================================

merged_df.to_csv("merged_city_data.csv", index=False)

print("\nMerged dataset saved successfully.")

# ==========================================
# STEP 11: Reload merged dataset
# ==========================================

merged_df = pd.read_csv("merged_city_data.csv")

# ==========================================
# STEP 12: Check missing values
# ==========================================

print("\nMissing values in each column:")
print(merged_df.isnull().sum())

# ==========================================
# STEP 13: Check important missing values
# ==========================================

missing_values = merged_df.loc[:, [
    'accept_time',
    'delivery_time',
    'lng',
    'lat',
    'courier_id'
]].isnull().sum()

print("\nImportant Missing Values:")
print(missing_values)

# ==========================================
# STEP 14: Remove rows with missing times
# ==========================================

merged_df = merged_df.dropna(
    subset=['accept_time', 'delivery_time']
)

print("\nShape after dropping missing time rows:")
print(merged_df.shape)

# ==========================================
# STEP 15: Fill missing latitude & longitude
# ==========================================

mean_lat_lng = merged_df.groupby('city')[['lat', 'lng']].transform('mean')

merged_df['lat'] = merged_df['lat'].fillna(mean_lat_lng['lat'])
merged_df['lng'] = merged_df['lng'].fillna(mean_lat_lng['lng'])

# ==========================================
# STEP 16: Find duplicate order IDs
# ==========================================

duplicates = merged_df[
    merged_df['order_id'].isin(
        merged_df['order_id'][
            merged_df['order_id'].duplicated()
        ]
    )
]

print("\nDuplicate Order IDs:")
print(duplicates.head())

# ==========================================
# STEP 17: Convert data types
# ==========================================

merged_df = merged_df.assign(

    # Convert datetime columns
    accept_time=pd.to_datetime(
        '2024-' + merged_df['accept_time'].astype(str),
        format='%Y-%m-%d %H:%M:%S',
        errors='coerce'
    ),

    delivery_time=pd.to_datetime(
        '2024-' + merged_df['delivery_time'].astype(str),
        format='%Y-%m-%d %H:%M:%S',
        errors='coerce'
    ),

    # Convert numeric columns
    lat=pd.to_numeric(
        merged_df['lat'],
        errors='coerce'
    ),

    lng=pd.to_numeric(
        merged_df['lng'],
        errors='coerce'
    ),

    # Convert categorical column
    aoi_type=merged_df['aoi_type'].astype('category')
)

# ==========================================
# STEP 18: Final dataset information
# ==========================================

print("\nFinal Data Types:")
print(merged_df.dtypes)

print("\nFinal Dataset Shape:")
print(merged_df.shape)

print("\nFinal Preview:")
print(merged_df.head())
